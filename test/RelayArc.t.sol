pragma solidity ^0.8.28;
import {PurserRelayArc} from "../contracts/PurserRelayArc.sol";
interface Vm { function deal(address,uint256) external; function prank(address) external; function warp(uint256) external; function expectRevert(bytes4) external; function chainId(uint256) external; }
contract Rejector { bool public reject = true; function toggle() external {reject=false;} function claim(PurserRelayArc r,bytes32 id) external {r.claimPayment(id);} receive() external payable { require(!reject,"reject"); } }
contract Reenter { PurserRelayArc public r; bytes32 public id; bool public blocked; function claim(PurserRelayArc rr,bytes32 ii) external {r=rr;id=ii;r.claimPayment(id);} receive() external payable {try r.claimPayment(id) {revert("reentered");} catch {blocked=true;}} }
contract Donation { constructor() payable {} function donate(address payable r) external {selfdestruct(r);} }
contract RejectOwner { function create(PurserRelayArc r,uint64 d) external payable returns(bytes32){return r.createOrder{value:msg.value}(bytes32(uint256(44)),bytes32(uint256(2)),bytes32(uint256(3)),address(0xD0000),msg.value,d,address(0xA0000),address(0xB0000));} function refund(PurserRelayArc r,bytes32 id) external {r.claimRefund(id);} receive() external payable {revert();} }
contract RelayArcTest {
    Vm constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
    PurserRelayArc r; address constant OWNER=address(0x10000); address constant A=address(0xA0000); address constant B=address(0xB0000); address constant C=address(0xC0000); address constant PAYEE=address(0xD0000);
    bytes32 constant REQUEST=bytes32(uint256(2)); bytes32 constant RULE=bytes32(uint256(3)); bytes32 constant ART=bytes32(uint256(4));
    function setUp() public {vm.chainId(5042);vm.warp(100);vm.deal(OWNER,100 ether);r=new PurserRelayArc();}
    function make(uint256 n,address payee) internal returns(bytes32 id){vm.prank(OWNER);id=r.createOrder{value:1 ether}(bytes32(n),REQUEST,RULE,payee,1 ether,200,A,B);}
    function submit(bytes32 id) internal {vm.prank(A);r.submitDeliverable(id,1,REQUEST,ART);}
    function approve(bytes32 id) internal {vm.prank(OWNER);r.approve(id,ART,RULE);}
    function eq(uint256 a,uint256 b) internal pure {require(a==b,"unequal");}
    function status(bytes32 id,PurserRelayArc.Status s) internal view {require(r.getOrder(id).status==s,"state");}
    function conservation(bytes32 id) internal view { (uint256 l,uint256 a,uint256 c,uint256 f)=r.accounting(id);require(l+a+c+f==r.getOrder(id).principal,"order conservation");require(r.totalPrincipal()==r.totalLocked()+r.totalApproved()+r.totalClaimed()+r.totalRefunded(),"aggregate conservation"); require(address(r).balance>=r.liabilities(),"solvent");}
    function testLifecycleIndependentPayeeAndPermanentCredit() public {bytes32 id=make(1,PAYEE);submit(id);approve(id);eq(PAYEE.balance,0);vm.warp(500);vm.expectRevert(PurserRelayArc.WrongState.selector);r.expire(id);vm.prank(PAYEE);r.claimPayment(id);eq(PAYEE.balance,1 ether);status(id,PurserRelayArc.Status.Claimed);conservation(id);}
    function testDuplicateIntentPositiveFutureDeadline() public {bytes32 id=make(1,PAYEE);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.DuplicateIntent.selector);r.createOrder{value:1 ether}(bytes32(uint256(1)),REQUEST,RULE,PAYEE,1 ether,300,A,B);conservation(id);}
    function testDuplicateAfterTerminal() public {bytes32 id=make(1,PAYEE);submit(id);approve(id);vm.prank(PAYEE);r.claimPayment(id);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.DuplicateIntent.selector);r.createOrder{value:1 ether}(bytes32(uint256(1)),REQUEST,RULE,PAYEE,1 ether,300,A,B);}
    function testReplacementRejectsLateAndOldEpoch() public {bytes32 id=make(1,PAYEE);vm.prank(OWNER);r.replaceWorker(id,A,C);eq(r.getOrder(id).authorityEpoch,2);require(r.getOrder(id).payee==PAYEE);vm.prank(A);vm.expectRevert(PurserRelayArc.Unauthorized.selector);r.submitDeliverable(id,2,REQUEST,ART);vm.prank(B);vm.expectRevert(PurserRelayArc.EpochMismatch.selector);r.submitDeliverable(id,1,REQUEST,ART);vm.prank(C);r.submitDeliverable(id,2,REQUEST,ART);conservation(id);}
    function testUnauthorizedWorker() public {bytes32 id=make(1,PAYEE);vm.prank(C);vm.expectRevert(PurserRelayArc.Unauthorized.selector);r.submitDeliverable(id,1,REQUEST,ART);}
    function testRevocationTombstone() public {bytes32 id=make(1,PAYEE);vm.prank(OWNER);r.revokeWorker(id,A);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.InvalidInput.selector);r.replaceWorker(id,B,A);vm.prank(A);vm.expectRevert(PurserRelayArc.Unauthorized.selector);r.submitDeliverable(id,2,REQUEST,ART);}
    function testTwoWorkerRaceAndSubmittedFreeze() public {bytes32 id=make(1,PAYEE);submit(id);vm.prank(B);vm.expectRevert(PurserRelayArc.WrongState.selector);r.submitDeliverable(id,1,REQUEST,ART);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.WrongState.selector);r.replaceWorker(id,A,C);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.WrongState.selector);r.revokeWorker(id,B);}
    function testHashBindings() public {bytes32 id=make(1,PAYEE);vm.prank(A);vm.expectRevert(PurserRelayArc.HashMismatch.selector);r.submitDeliverable(id,1,RULE,ART);submit(id);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.HashMismatch.selector);r.approve(id,RULE,RULE);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.HashMismatch.selector);r.approve(id,ART,ART);}
    function testOnlyOwnerApproveAndReplace() public {bytes32 id=make(1,PAYEE);vm.prank(C);vm.expectRevert(PurserRelayArc.Unauthorized.selector);r.replaceWorker(id,A,C);submit(id);vm.prank(C);vm.expectRevert(PurserRelayArc.Unauthorized.selector);r.approve(id,ART,RULE);}
    function testDeadlineExactSubmittedRefund() public {bytes32 id=make(1,PAYEE);submit(id);vm.warp(200);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.Expired.selector);r.approve(id,ART,RULE);r.expire(id);vm.prank(OWNER);r.claimRefund(id);status(id,PurserRelayArc.Status.Refunded);conservation(id);}
    function testDeadlineExactFunded() public {bytes32 id=make(1,PAYEE);vm.expectRevert(PurserRelayArc.NotExpired.selector);r.expire(id);vm.warp(200);vm.prank(A);vm.expectRevert(PurserRelayArc.Expired.selector);r.submitDeliverable(id,1,REQUEST,ART);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.Expired.selector);r.replaceWorker(id,A,C);r.expire(id);conservation(id);}
    function testApprovedCannotRefund() public {bytes32 id=make(1,PAYEE);submit(id);approve(id);vm.warp(201);vm.expectRevert(PurserRelayArc.WrongState.selector);r.expire(id);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.WrongState.selector);r.claimRefund(id);conservation(id);}
    function testRepeatedClaimRejected() public {bytes32 id=make(1,PAYEE);submit(id);approve(id);vm.prank(PAYEE);r.claimPayment(id);vm.prank(PAYEE);vm.expectRevert(PurserRelayArc.WrongState.selector);r.claimPayment(id);eq(PAYEE.balance,1 ether);}
    function testRefundTerminalRejectsAll() public {bytes32 id=make(1,PAYEE);vm.warp(200);r.expire(id);vm.prank(OWNER);r.claimRefund(id);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.WrongState.selector);r.claimRefund(id);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.WrongState.selector);r.approve(id,ART,RULE);vm.prank(PAYEE);vm.expectRevert(PurserRelayArc.WrongState.selector);r.claimPayment(id);}
    function testRejectingPayeeIsolationAndRetry() public {Rejector p=new Rejector();bytes32 x=make(1,address(p));bytes32 y=make(2,PAYEE);bytes32 z=make(3,PAYEE);submit(x);approve(x);submit(y);approve(y);vm.expectRevert(PurserRelayArc.TransferFailed.selector);p.claim(r,x);eq(r.getOrder(x).credit,1 ether);status(x,PurserRelayArc.Status.Approved);vm.prank(PAYEE);r.claimPayment(y);vm.warp(200);r.expire(z);vm.prank(OWNER);r.claimRefund(z);conservation(x);conservation(y);conservation(z);p.toggle();p.claim(r,x);conservation(x);eq(address(p).balance,1 ether);}
    function testRefundDoesNotCallPayee() public {Rejector p=new Rejector();bytes32 id=make(1,address(p));vm.warp(200);r.expire(id);vm.prank(OWNER);r.claimRefund(id);eq(address(p).balance,0);conservation(id);}
    function testRejectingOwnerRetainsRefundCredit() public {RejectOwner o=new RejectOwner();vm.deal(address(this),1 ether);bytes32 id=o.create{value:1 ether}(r,200);vm.warp(200);r.expire(id);vm.expectRevert(PurserRelayArc.TransferFailed.selector);o.refund(r,id);status(id,PurserRelayArc.Status.Refundable);eq(r.getOrder(id).credit,1 ether);conservation(id);}
    function testPayeeReentrancyBlocked() public {Reenter p=new Reenter();bytes32 id=make(1,address(p));submit(id);approve(id);p.claim(r,id);require(p.blocked());eq(address(p).balance,1 ether);conservation(id);}
    function testForcedDonationDoesNotCreateCredit() public {bytes32 id=make(1,PAYEE);vm.deal(address(this),2 ether);Donation d=new Donation{value:2 ether}();d.donate(payable(address(r)));eq(r.surplus(),2 ether);eq(r.getOrder(id).credit,0);conservation(id);}
    function testCrossChainContractOrderDomains() public {bytes32 id=make(1,PAYEE);PurserRelayArc other=new PurserRelayArc();require(other.computeOrderId(OWNER,bytes32(uint256(1)))!=id);vm.chainId(5043);require(r.computeOrderId(OWNER,bytes32(uint256(1)))!=id);vm.chainId(5042);bytes32 second=make(2,PAYEE);require(second!=id);vm.prank(A);vm.expectRevert(PurserRelayArc.HashMismatch.selector);r.submitDeliverable(second,1,RULE,ART);}
    function testWrongValueAndZeroAddresses() public {vm.prank(OWNER);vm.expectRevert(PurserRelayArc.InvalidInput.selector);r.createOrder{value:1}(bytes32(uint256(1)),REQUEST,RULE,PAYEE,1 ether,200,A,B);vm.prank(OWNER);vm.expectRevert(PurserRelayArc.InvalidInput.selector);r.createOrder{value:1 ether}(bytes32(uint256(1)),REQUEST,RULE,address(0),1 ether,200,A,B);}
    function testNative18SubMicroAmountPreserved() public {vm.prank(OWNER);bytes32 id=r.createOrder{value:123456789}(bytes32(uint256(1)),REQUEST,RULE,PAYEE,123456789,200,A,B);submit(id);approve(id);vm.prank(PAYEE);r.claimPayment(id);eq(PAYEE.balance,123456789);conservation(id);}
    function testFuzzAmountConservation(uint96 raw,bool paid) public {uint256 amount=uint256(raw)+1;vm.deal(OWNER,amount);vm.prank(OWNER);bytes32 id=r.createOrder{value:amount}(bytes32(uint256(1)),REQUEST,RULE,PAYEE,amount,200,A,B);conservation(id);if(paid){submit(id);conservation(id);approve(id);conservation(id);vm.prank(PAYEE);r.claimPayment(id);}else {vm.warp(200);r.expire(id);conservation(id);vm.prank(OWNER);r.claimRefund(id);}conservation(id);}
}
